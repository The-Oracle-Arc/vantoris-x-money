# Public frontend config. These values identify the Base44 app; they are not credentials.
VITE_BASE44_APP_ID=6a3d85c1632966fefe16f3d4
VITE_BASE44_SERVER_URL=https://vantoris.base44.app
VITE_BASE44_APP_BASE_URL=https://vantoris-platform.netlify.app

# Server-side Base44 session validation. Never use VITE_ for secrets.
BASE44_APP_ID=6a3d85c1632966fefe16f3d4
BASE44_SERVER_URL=https://vantoris.base44.app

# Provider keys are server-only Netlify environment variables.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Comma-separated fallback order. Base44 InvokeLLM remains an available provider.
AI_PROVIDER_ORDER=openrouter,groq,gemini,anthropic,base44,private

# Durable usage controls (Upstash Redis REST). Requests fail closed if not configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_FREE_MONTHLY_REQUESTS=30
AI_PAID_MONTHLY_REQUESTS=300
AI_PER_MINUTE_REQUESTS=5
# Server-managed allowlist until a verified subscription webhook/entitlement service is connected.
AI_SUBSCRIBER_USER_IDS=
AI_MAX_OUTPUT_TOKENS=700
# Conservative reservation charged before provider invocation; values are USD cents.
AI_MAX_REQUEST_COST_CENTS=10
AI_MAX_DAILY_SPEND_CENTS=2000

# Optional OpenAI-compatible private endpoint (for example, an authorized self-hosted model).
PRIVATE_LLM_URL=
PRIVATE_LLM_MODEL=qwen2.5:7b
PRIVATE_LLM_KEY=

# Configure only after authorized provider integrations and backend validation exist.
PAYMENTS_SECRET_KEY=
FLIGHTS_API_KEY=
CARDS_ISSUER_KEY=
SHIPPING_API_KEY=
NEWS_API_KEY=
