{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "action_type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "target_user_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "action_type",
    "description",
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrator"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        },
        {
          "user_condition": {
            "role": "finance_officer"
          }
        },
        {
          "user_condition": {
            "role": "treasury_officer"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}
