            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrator"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        },
        {
          "user_condition": {
            "role": "finance_officer"
          }
        },
        {
          "user_condition": {
            "role": "treasury_officer"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
