      "type": "string"
    },
    "cursor_name": {
      "type": "string"
    },
    "after_event_id": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "provider_id",
    "cursor_name",
    "after_event_id"
  ],
  "rls": {
