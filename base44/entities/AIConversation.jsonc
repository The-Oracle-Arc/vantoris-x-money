{
  "name":"AIConversation","type":"object",
  "properties":{"user_id":{"type":"string"},"title":{"type":"string"},"status":{"type":"string","enum":["active","archived"],"default":"active"}},
  "required":["user_id","title"],
  "rls":{"create":{"user_condition":{"id":"{{user.id}}"}},"read":{"user_condition":{"id":"{{user.id}}"}},"update":{"user_condition":{"id":"{{user.id}}"}},"delete":false}
}